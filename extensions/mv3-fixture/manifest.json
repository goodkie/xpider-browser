{
  "manifest_version": 3,
  "name": "LCW MV3 Fixture Extension",
  "version": "1.0.0",
  "description": "Verification fixture for Lite Chromium Portable P1A/Spike",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LCW Fixture"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
