{
  "manifest_version": 3,
  "name": "XPIDER VPN",
  "version": "2.6.4",
  "description": "안전하고 빠른 익명 서핑을 위한 전용 프록시 및 VPN 솔루션입니다. 전 세계 고속 노드를 지원합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
