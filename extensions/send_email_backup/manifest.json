{
  "manifest_version": 3,
  "name": "XPIDER SendForce Mailer Pro",
  "version": "2.0.63",
  "description": "대량 메일 발송 및 마케팅 캠페인을 위한 강력한 자동화 솔루션입니다. 높은 도달율과 익명 발송 기능을 지원합니다.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://anonymousemail.me/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "security-token.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "999.0.0.0"
}