{
  "manifest_version": 2,
  "name": "Bing Maps Business Finder",
  "version": "1.1.59",
  "description": "빙 맵스(Bing Maps)에서 비즈니스 정보를 추출하고 이메일 및 연락처를 발굴하는 전문가용 데이터 수집 엔진입니다.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "sidePanel",
    "offscreen",
    "audioCapture",
    "downloads",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "webNavigation",
    "https://www.bing.com/maps*",
    "https://www.bing.com/search*",
    "*://*.bing.com/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bing.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "security-token.json"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}