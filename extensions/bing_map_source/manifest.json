{
  "manifest_version": 3,
  "name": "Bing Maps Business Finder",
  "version": "1.1.0",
  "description": "Professional Bing Maps business lead generator with email finder and side panel UI.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "sidePanel",
    "offscreen",
    "audioCapture",
    "downloads",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.bing.com/maps*",
    "https://www.bing.com/search*",
    "*://*.bing.com/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bing.com/maps*",
        "*://*.bing.com/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
