{
  "manifest_version": 3,
  "name": "XPIDER Pro - Local Business Data Crawler v1.2.3 Pro",
  "version": "1.2.59",
  "description": "웹에서 비즈니스 정보를 수집하고 이메일, 전화번호, SNS 링크 등을 추출하는 심층 데이터 크롤러 프로 버전입니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "sidePanel",
    "webNavigation",
    "offscreen",
    "audioCapture",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "translations.js",
        "business_dictionaries.js",
        "global_blacklist.js",
        "language_filters.js",
        "noise_dictionary.js",
        "business_filters.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "999.0.0.0",
  "web_accessible_resources": [
    {
      "resources": [
        "security-token.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}