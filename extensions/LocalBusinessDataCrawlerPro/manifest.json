{
    "manifest_version": 3,
    "name": "XPIDER Pro - Local Business Data Crawler v1.1.9 Pro",
    "version": "1.1.9",
    "description": "웹에서 비즈니스 정보를 수집하고 이메일, 전화번호, SNS 링크 등을 추출하는 심층 데이터 크롤러 프로 버전입니다.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "tabs",
        "scripting",
        "storage",
        "activeTab",
        "sidePanel",
        "webNavigation",
        "offscreen",
        "audioCapture",
        "proxy",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "translations.js",
                "business_dictionaries.js",
                "global_blacklist.js",
                "language_filters.js",
                "noise_dictionary.js",
                "business_filters.js",
                "content.js"
            ],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.google.com/recaptcha/*",
                "*://*.google.co.kr/recaptcha/*",
                "https://www.google.com/recaptcha/*",
                "https://www.gstatic.com/recaptcha/*",
                "*://*.google.com/sorry/*",
                "*://*.google.co.kr/sorry/*",
                "*://*.google.co.jp/sorry/*",
                "*://*.google.co.uk/sorry/*",
                "*://*.google.com.sg/sorry/*",
                "*://*.google.com.hk/sorry/*",
                "*://*.google.com.tw/sorry/*",
                "*://*.google.ca/sorry/*",
                "*://*.google.de/sorry/*",
                "*://*.google.fr/sorry/*",
                "*://*.google.it/sorry/*",
                "*://*.google.es/sorry/*"
            ],
            "js": [
                "translations.js",
                "challenge_solver_content.js"
            ],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        }
    ]
}