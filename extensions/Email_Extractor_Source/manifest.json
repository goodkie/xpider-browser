{
  "manifest_version": 3,
  "name": "Email Extractor",
  "short_name": "EmailExt",
  "description": "방문하는 웹페이지에서 실시간으로 이메일 주소를 감지하고 수집하는 고성능 리드 추출 엔진입니다.",
  "version": "1.0.22",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
