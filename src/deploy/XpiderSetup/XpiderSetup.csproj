<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>XPIDER-Setup</AssemblyName>
    <RootNamespace>XpiderSetup</RootNamespace>
    <ApplicationIcon>..\..\..\assets\icons\win\icon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- NuGet 패키지 없이 .NET 4.8 GAC 참조만 사용 -->
    <!-- NuGet System.IO.Compression 패키지가 4.2.0.0 의존성을 만들어 에러 유발하므로 제거 -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- .NET 4.8 프레임워크에 내장된 어셈블리만 참조 (NuGet 없음) -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.zip" Condition="Exists('Resources\app.zip')" />
    <EmbeddedResource Include="Resources\logo.png" Condition="Exists('Resources\logo.png')" />
    <EmbeddedResource Include="Resources\Fonts\Poppins-Regular.ttf" Condition="Exists('Resources\Fonts\Poppins-Regular.ttf')" />
    <EmbeddedResource Include="Resources\Fonts\Poppins-Bold.ttf" Condition="Exists('Resources\Fonts\Poppins-Bold.ttf')" />
  </ItemGroup>

</Project>