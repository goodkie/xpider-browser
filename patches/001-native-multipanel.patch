diff --git a/chrome/browser/ui/views/side_panel/side_panel_coordinator.cc b/chrome/browser/ui/views/side_panel/side_panel_coordinator.cc
index 0000000..9a1e7c0 100644
--- a/chrome/browser/ui/views/side_panel/side_panel_coordinator.cc
+++ b/chrome/browser/ui/views/side_panel/side_panel_coordinator.cc
@@ -0,0 +1,63 @@
+// Copyright 2024 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// P2 Multi-Panel Slot Implementation (REVIEW_READY prototype)
+// Target upstream: 73c14f6228d7cd537c855007e8f88678969cc0eb
+//
+// IMPORTANT: This file extends (does NOT replace) the existing
+// side_panel_coordinator.cc. In a live Chromium tree, the methods
+// below are appended to the existing translation unit.
+
+#include "chrome/browser/ui/views/side_panel/side_panel_coordinator.h"
+
+#include "base/check.h"
+#include "base/notreached.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+
+// ---------------------------------------------------------------------------
+// SidePanelCoordinator::ShowSlot
+// ---------------------------------------------------------------------------
+// Creates or reuses a PanelSlot for |slot_id|.
+// If a slot already exists for this id and has a different key loaded,
+// the previous host_view is detached and a new one is allocated.
+// ---------------------------------------------------------------------------
+void SidePanelCoordinator::ShowSlot(SidePanelEntryKey key,
+                                    PanelInstanceId slot_id) {
+  auto it = active_slots_.find(slot_id);
+  if (it != active_slots_.end()) {
+    // Slot exists. If same key is already loaded, no-op.
+    if (it->second.current_key.has_value() &&
+        it->second.current_key.value() == key) {
+      return;
+    }
+    // Evict the old host view before replacing.
+    it->second.host_view.reset();
+    it->second.current_key = key;
+    it->second.host_view = std::make_unique<views::View>();
+    // TODO(P2): Route extension WebContents into host_view via
+    //           ExtensionSidePanelManager::GetOrCreateHostForKey(key, slot_id).
+  } else {
+    // Create new slot.
+    PanelSlot slot;
+    slot.slot_id = slot_id;
+    slot.current_key = key;
+    slot.host_view = std::make_unique<views::View>();
+    slot.host_view->SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kVertical));
+    // TODO(P2): Attach host_view to multi-panel container in BrowserView.
+    active_slots_.emplace(slot_id, std::move(slot));
+  }
+}
+
+// ---------------------------------------------------------------------------
+// SidePanelCoordinator::CloseSlot
+// ---------------------------------------------------------------------------
+void SidePanelCoordinator::CloseSlot(PanelInstanceId slot_id) {
+  active_slots_.erase(slot_id);
+}
+
+// ---------------------------------------------------------------------------
+// SidePanelCoordinator::GetSlotContainer
+// ---------------------------------------------------------------------------
+views::View* SidePanelCoordinator::GetSlotContainer(PanelInstanceId slot_id) {
+  auto it = active_slots_.find(slot_id);
+  return (it != active_slots_.end()) ? it->second.host_view.get() : nullptr;
+}
