diff --git a/chrome/browser/ui/side_panel/side_panel_entry_key.cc b/chrome/browser/ui/side_panel/side_panel_entry_key.cc
index a354372..c3f3ecb 100644
--- a/chrome/browser/ui/side_panel/side_panel_entry_key.cc
+++ b/chrome/browser/ui/side_panel/side_panel_entry_key.cc
@@ -2,6 +2,12 @@ SidePanelEntryKey::SidePanelEntryKey(
     const extensions::ExtensionId& extension_id)
     : id_(id), extension_id_(extension_id) {}
 
+SidePanelEntryKey::SidePanelEntryKey(
+    SidePanelEntryId id,
+    const extensions::ExtensionId& extension_id,
+    PanelInstanceId instance_id)
+    : id_(id), extension_id_(extension_id), instance_id_(instance_id) {}
+
 SidePanelEntryKey::SidePanelEntryKey(const SidePanelEntryKey& other) = default;
 
 SidePanelEntryKey& SidePanelEntryKey::operator=(
@@ -10,9 +16,16 @@ SidePanelEntryKey& SidePanelEntryKey::operator=(
 SidePanelEntryKey::~SidePanelEntryKey() = default;
 
 bool SidePanelEntryKey::operator==(const SidePanelEntryKey& other) const {
-  return id_ == other.id_ && extension_id_ == other.extension_id_;
+  return id_ == other.id_ && extension_id_ == other.extension_id_ &&
+         instance_id_ == other.instance_id_;
 }
 
 bool SidePanelEntryKey::operator<(const SidePanelEntryKey& other) const {
-  return id_ < other.id_;
+  if (id_ != other.id_) {
+    return id_ < other.id_;
+  }
+  if (extension_id_ != other.extension_id_) {
+    return extension_id_ < other.extension_id_;
+  }
+  return instance_id_ < other.instance_id_;
 }
