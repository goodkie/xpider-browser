{
  "name": "xpider-browser",
  "version": "4.12.11",
  "description": "Custom Chromium Browser for XPIDER",
  "main": "src/main.js",
  "scripts": {
    "clean-locks": "powershell -NoProfile -Command \"Get-ChildItem -Path 'data','$env:APPDATA\\\\xpider-browser' -Filter LOCK -Recurse -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; Write-Host '[XPIDER] LOCK files cleaned'\"",
    "start": "npm run clean-locks && electron-forge start",
    "landing:dev": "npx -y http-server ./landing -p 8080",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:win-zip": "electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "make:mac": "electron-forge make --platform=darwin --arch=x64",
    "make:mac-arm": "electron-forge make --platform=darwin --arch=arm64",
    "publish": "electron-forge publish",
    "sync": "git add -A && git commit -m \"dev-sync: %date% %time%\" && git push origin main",
    "sync:ext": "cd extensions/google_maps_extension_source && git add -A && git commit -m \"ext-sync\" && git push"
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.3.0",
    "electron": "latest",
    "electron-forge-maker-nsis": "^26.8.1",
    "electron-icon-maker": "^0.0.5",
    "tweetsodium": "^0.0.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.4.2",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.7",
    "stripe": "^22.1.1"
  }
}
