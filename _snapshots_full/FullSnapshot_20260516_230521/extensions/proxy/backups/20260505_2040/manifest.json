{
  "manifest_version": 3,
  "name": "Antigravity VPN",
  "version": "2.0.0",
  "description": "Seamless VPN powered by WebShare",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestAuthProvider",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
